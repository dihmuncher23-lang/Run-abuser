local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local playerGui = player:FindFirstChild("PlayerGui") or CoreGui

if playerGui:FindFirstChild("BarrelAbilityGUI") then
    playerGui.BarrelAbilityGUI:Destroy()
end

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "BarrelAbilityGUI"
screenGui.ResetOnSpawn = false
screenGui.IgnoreGuiInset = true 
screenGui.DisplayOrder = 2147483647 
screenGui.Parent = playerGui

local button = Instance.new("TextButton")
button.Name = "AbilityButton"
-- Adjusted to a comfortable medium size (Width: 160, Height: 70)
button.Size = UDim2.new(0, 160, 0, 70)
button.Position = UDim2.new(0.5, -80, 0.8, -35)
button.BackgroundColor3 = Color3.fromRGB(160, 82, 45)
button.Text = "Throw Barrel"
button.TextColor3 = Color3.fromRGB(187, 0, 255)
button.TextSize = 20 
button.Font = Enum.Font.FredokaOne
button.ZIndex = 10 
button.Parent = screenGui

local uiCorner = Instance.new("UICorner", button)
uiCorner.CornerRadius = UDim.new(0, 14)

-- Lock Button
local lockBtn = Instance.new("TextButton")
lockBtn.Size = UDim2.new(0, 30, 0, 30)
lockBtn.Position = UDim2.new(1, -34, 0, 4)
lockBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
lockBtn.Text = "🔓"
lockBtn.TextSize = 14
lockBtn.Font = Enum.Font.SourceSansBold
lockBtn.TextColor3 = Color3.new(1, 1, 1)
lockBtn.ZIndex = 20 
lockBtn.Parent = button

local lockCorner = Instance.new("UICorner", lockBtn)
lockCorner.CornerRadius = UDim.new(0, 7)

local locked = false
local isOnCooldown = false

lockBtn.MouseButton1Click:Connect(function()
    locked = not locked
    lockBtn.Text = locked and "🔒" or "🔓"
    lockBtn.BackgroundColor3 = locked and Color3.fromRGB(150, 40, 40) or Color3.fromRGB(40, 40, 40)
end)

button.MouseButton1Click:Connect(function()
    if isOnCooldown then return end
    
    local character = player.Character
    if not character then return end
    
    local tool = character:FindFirstChild("Barrel")
    
    if tool then
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        local event = ReplicatedStorage:FindFirstChild("GeneralAbility")
        
        if event and rootPart then
            isOnCooldown = true
            event:FireServer({["cf"] = rootPart.CFrame})
            
            button.Text = "active"
            task.wait(1.5)
            button.Text = "on cooldown"
            task.wait(3.5)
            
            button.Text = "Throw Barrel"
            isOnCooldown = false
        end
    else
        button.Text = "No Barrel!"
        task.wait(1)
        button.Text = "Throw Barrel"
    end
end)

-- Draggable Logic
local dragging, dragStart, startPos
button.InputBegan:Connect(function(input)
    if not locked and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
        dragging = true
        dragStart = input.Position
        startPos = button.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and not locked and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        button.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

button.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)
