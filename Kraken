local DragRing = Instance.new("Frame")
DragRing.Name = "DragRing"
DragRing.Size = UDim2.new(1, 0, 1, 0)
DragRing.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
DragRing.BackgroundTransparency = 0.2
DragRing.BorderSizePixel = 0
DragRing.Active = true
DragRing.Parent = MainFrame

local RingCorner = Instance.new("UICorner")
RingCorner.CornerRadius = UDim.new(1, 0)
RingCorner.Parent = DragRing

local RingStroke = Instance.new("UIStroke")
RingStroke.Color = Color3.fromRGB(0, 229, 255)
RingStroke.Thickness = 3
RingStroke.Parent = DragRing

-- Inner Action Button (Tap this to fire the Kraken ability)
local Button = Instance.new("TextButton")
Button.Name = "KrakenButton"
Button.Size = UDim2.new(0, 64, 0, 64)
Button.AnchorPoint = Vector2.new(0.5, 0.5)
Button.Position = UDim2.new(0.5, 0, 0.5, 0)
Button.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
Button.TextColor3 = Color3.fromRGB(255, 255, 255)
Button.TextSize = 12
Button.Font = Enum.Font.GothamBold
