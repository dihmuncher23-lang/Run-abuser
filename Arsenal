    local function CleanupPlayerESP(player)
        local esp = EspData[player]
        if esp then
            if esp.Highlight then
                pcall(function()
                    esp.Highlight:Destroy()
                end)
            end
            if esp.Tracer then
                pcall(function()
                    esp.Tracer:Destroy()
                end)
            end
            if esp.Nametag then
                pcall(function()
                    esp.Nametag:Destroy()
                end)
            end
            if esp.Box3D then
                pcall(function()
                    esp.Box3D:Destroy()
                end)
            end
            if esp.Box2D then
                for _, line in pairs(esp.Box2D) do
                    pcall(function()
                        line:Destroy()
                    end)
                end
            end
            if esp.HealthBar then
                pcall(function()
                    esp.HealthBar.Back:Destroy()
                end)
                pcall(function()
                    esp.HealthBar.Fill:Destroy()
                end)
            end
            EspData[player] = nil
        end
    end

    local function ClearAllESP()
        for _, player in ipairs(Players:GetPlayers()) do
            CleanupPlayerESP(player)
        end
    end

