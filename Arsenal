                                                esp.HealthBar.Back.From = Vector2.new(xPos, topLeft.Y)
                                                esp.HealthBar.Back.To = Vector2.new(xPos, topLeft.Y + height)
                                                esp.HealthBar.Back.Visible = true
                                                esp.HealthBar.Fill.From = Vector2.new(xPos, topLeft.Y + height)
                                                esp.HealthBar.Fill.To = Vector2.new(xPos, topLeft.Y + height - height * healthPercent)
                                                esp.HealthBar.Fill.Color = Color3.fromRGB(255 - 255 * healthPercent, 255 * healthPercent, 0)
                                                esp.HealthBar.Fill.Visible = true
                                            else
                                                if esp.HealthBar then
                                                    esp.HealthBar.Back.Visible = false
                                                    esp.HealthBar.Fill.Visible = false
                                                end

                                                if Visuals.Boxes3D then
                                                    if not esp.Box3D then
                                                        local box = Instance.new("SelectionBox")
                                                        box.Name = "YXZ_3DBox"
                                                        box.LineThickness = 0.05
                                                        box.Color3 = GetPlayerColor(player)
                                                        box.Parent = Camera
                                                        EspData[player].Box3D = box
                                                    end
                                                    esp.Box3D.Color3 = GetPlayerColor(player)
                                                    esp.Box3D.Adornee = player.Character
                                                    esp.Box3D.Visible = true
                                                else
                                                    if esp.Box3D then
                                                        EspData[player].Box3D.Visible = false
                                                    end

                                                    if Visuals.Nametags then
                                                        if not esp.Nametag then
                                                            esp.Nametag = Drawing.new("Text")
                                                            esp.Nametag.Size = 13
                                                            esp.Nametag.Center = true
                                                            esp.Nametag.Outline = true
                                                            esp.Nametag.Font = 3
                                                        end
                                                        esp.Nametag.Color = GetPlayerColor(player)
                                                        esp.Nametag.Text = player.DisplayName or player.Name
                                                        esp.Nametag.Position = Vector2.new(worldPoint.X, topLeft.Y - 15)
                                                        esp.Nametag.Visible = true
                                                    else
                                                        if EspData[player].Nametag then
                                                            EspData[player].Nametag.Visible = false
                                                        end
                                                    end
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end)
end
