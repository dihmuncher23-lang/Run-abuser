        end

        if Visuals.Crosshair then
            local mousePos = UserInputService:GetMouseLocation()
            local spinAngle = Visuals.CrosshairSpin and tick() * 3 or 0
            local gap = Visuals.CrosshairGap
            for direction, angle in pairs({
                Right = 0,
                Bottom = math.pi / 2,
                Left = math.pi,
                Top = math.pi * 1.5
            }) do
                local offset = spinAngle + angle
                local directionVector = Vector2.new(math.cos(offset), math.sin(offset))
                local line = CrosshairLines[direction]
                line.Color = Visuals.CrosshairColor
                line.From = mousePos + directionVector * gap
                line.To = mousePos + directionVector * (gap + Visuals.CrosshairSize)
                line.Visible = true
            end
        else
            for _, line in pairs(CrosshairLines) do
                line.Visible = false
            end
            HandleMotionTrails(rootPart)
            
            local combatEnabled = Settings.Enabled or Rage.KillAll or Settings.Aimlock
            local spinbotEnabled = Movement.Spinbot
            
            if combatEnabled and rootPart then
                local target = GetClosestTarget()
                if target then
                    local targetPart = GetTargetPart(target.Character)
                    if targetPart then
                        local targetPosition = targetPart.Position
                        if Settings.Prediction then
                            targetPosition = targetPart.Position + targetPart.AssemblyLinearVelocity * Settings.PredictionFactor
                        end
                        
                        if Rage.KillAll then
                            OrbitAngle = (OrbitAngle + 2 * deltaTime) % (math.pi * 2)
                            local newCFrame = CFrame.new(targetPosition + Vector3.new(math.cos(OrbitAngle) * 2, 0, math.sin(OrbitAngle) * 2), targetPosition)
                            rootPart.CFrame = newCFrame
                            local tool = character:FindFirstChildOfClass("Tool")
