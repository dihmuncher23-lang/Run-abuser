            local velocity = Vector3.new()
            if KeysPressed[Enum.KeyCode.W] then
                velocity = velocity + Camera.CFrame.LookVector
            end
            if KeysPressed[Enum.KeyCode.S] then
                velocity = velocity - Camera.CFrame.LookVector
            end
            if KeysPressed[Enum.KeyCode.A] then
                velocity = velocity - Camera.CFrame.RightVector
            end
            if KeysPressed[Enum.KeyCode.D] then
                velocity = velocity + Camera.CFrame.RightVector
            end
            if KeysPressed[Enum.KeyCode.Space] then
                velocity = velocity + Vector3.new(0, 1, 0)
            end
            if KeysPressed[Enum.KeyCode.LeftShift] then
                velocity = velocity - Vector3.new(0, 1, 0)
            end
            rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            if velocity.Magnitude > 0 then
                rootPart.CFrame = rootPart.CFrame + velocity.Unit * Movement.FlySpeed * deltaTime
            end
        end

        if Movement.Noclip and character then
            for _, part in ipairs(character:GetDescendants()) do
                if part:IsA("BasePart") and part.CanCollide then
