    local function IsTeammate(player)
        if not Visuals.TeamCheck then
            return false
        end
        if not LocalPlayer.Team or not player.Team then
            return false
        end
        return LocalPlayer.Team == player.Team
    end

    local function GetClosestTarget()
        local maxDistance = Rage.KillAll and 99999 or Settings.Distance
        local closestDistance = math.huge
        local closestPlayer = nil
        local character = LocalPlayer.Character
        if not character or not character:FindFirstChild("HumanoidRootPart") then
            return nil
        end
        local rootPart = LocalPlayer.Character.HumanoidRootPart
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                if Settings.TeamCheck and IsTeammate(player) then
                else
                    local targetPart = GetTargetPart(player.Character)
                    if targetPart then
                        local distance = (player.Character.HumanoidRootPart.Position - rootPart.Position).Magnitude
                        if distance <= maxDistance then
                            local screenPoint = Camera:WorldToViewportPoint(targetPart.Position)
                            if Settings.UseFOV then
                                local fovDistance = (Vector2.new(screenPoint.X, screenPoint.Y) - UserInputService:GetMouseLocation()).Magnitude
                                if fovDistance <= Settings.FOVRadius and fovDistance < closestDistance then
                                    closestDistance = fovDistance
                                    closestPlayer = player
                                end
                            else
                                if distance < closestDistance then
                                    closestDistance = distance
                                    closestPlayer = player
                                end
                            end
                        end
                    end
                end
            end
        end
        return closestPlayer
    end

