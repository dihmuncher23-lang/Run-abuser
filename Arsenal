                        else
                            if Settings.Enabled then
                                local newCFrame = rootPart.CFrame
                                if Settings.Mode == "Orbit" then
                                    OrbitAngle = (OrbitAngle + Settings.Speed * deltaTime) % (math.pi * 2)
                                    newCFrame = CFrame.new(targetPosition + Vector3.new(math.cos(OrbitAngle) * Settings.Radius, Settings.Height, math.sin(OrbitAngle) * Settings.Radius), targetPosition)
                                elseif Settings.Mode == "Void Shoot" then
                                    VoidTimer = VoidTimer + deltaTime
                                    if VoidTimer >= 1 / math.clamp(Settings.Speed * 0.1, 0.1, 10) then
