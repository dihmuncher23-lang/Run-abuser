-- RGB Color Loop (Neon Effect)
RunService.RenderStepped:Connect(function()
	local hue = (tick() % 5) / 5
	local rgbColor = Color3.fromHSV(hue, 1, 1)
	uiStroke.Color = rgbColor
end)

-- Improved Global Dragging Functionality
local isLocked = false
local dragging = false
local dragStart, startPos

lockButton.MouseButton1Click:Connect(function()
	isLocked = not isLocked
	if isLocked then
		lockButton.Text = "LOC"
		lockButton.TextColor3 = Color3.fromRGB(255, 50, 50)
		lockStroke.Color = Color3.fromRGB(255, 50, 50)
	else
		lockButton.Text = "UNL"
		lockButton.TextColor3 = Color3.fromRGB(0, 255, 0)
		lockStroke.Color = Color3.fromRGB(0, 255, 0)
	end
end)

mainFrame.InputBegan:Connect(function(input)
	if isLocked then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = mainFrame.AbsolutePosition
		
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and not isLocked and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStart
		mainFrame.Position = UDim2.new(
			0, startPos.X + delta.X,
			0, startPos.Y + delta.Y
		)
	end
end)

-- Ability & Cooldown Logic (5.5 seconds)
local coolDownTime = 5.5
local isOnCooldown = false

abilityButton.MouseButton1Click:Connect(function()
	if dragging then return end
	if isOnCooldown then return end
	isOnCooldown = true
	
	-- Fire the Remote Event
	local success, err = pcall(function()
		local event = ReplicatedStorage:FindFirstChild("GeneralAbility")
		if event then
			event:FireServer()
		end
	end)
	
	if not success then
		warn("Failed to fire GeneralAbility event: " .. tostring(err))
	end
	
	-- Activate Cooldown Visuals
	cooldownOverlay.Visible = true
	cooldownText.Visible = true
	
	local startTime = tick()
	local connection
	
	connection = RunService.RenderStepped:Connect(function()
		local elapsed = tick() - startTime
		local timeLeft = coolDownTime - elapsed
		
		if timeLeft <= 0 then
			cooldownOverlay.Visible = false
			cooldownText.Visible = false
			cooldownText.Text = ""
			isOnCooldown = false
			connection:Disconnect()
		else
			cooldownText.Text = string.format("%.1f", timeLeft)
		end
	end)
end)
