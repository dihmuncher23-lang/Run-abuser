-- Create Compact Lock/Unlock Toggle Button below it
local lockButton = Instance.new("TextButton")
lockButton.Name = "LockButton"
lockButton.Size = UDim2.new(0, 70, 0, 24)
lockButton.Position = UDim2.new(0, 0, 0, 70)
lockButton.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
lockButton.TextColor3 = Color3.fromRGB(160, 160, 175)
lockButton.TextSize = 10
lockButton.Font = Enum.Font.GothamMedium
lockButton.Text = "🔓 Unlock"
