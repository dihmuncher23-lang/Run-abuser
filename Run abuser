lockStroke.Color = Color3.fromRGB(50, 50, 60)
lockStroke.Thickness = 1
lockStroke.Parent = lockButton

-- Cooldown & Dragging Logic
local abilityDuration = 3
local cooldownDuration = 5
local isOnCooldown = false
local isLocked = false
local dragging = false
local dragInput, dragStart, startPos

-- Function to execute the ability
local function runAbility()
    if isOnCooldown then return end
    isOnCooldown = true
    
    Event:FireServer()
    
    -- Phase 1: Ability is active (3 seconds) - Green state
    button.BackgroundColor3 = Color3.fromRGB(30, 160, 70)
    buttonGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(60, 210, 100)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(20, 120, 50))
    })
    for i = abilityDuration, 1, -1 do
        textLabel.Text = tostring(i)
        task.wait(1)
    end
    
    -- Phase 2: Cooldown starts after ability ends (5 seconds) - Orange state
    button.BackgroundColor3 = Color3.fromRGB(200, 90, 20)
    buttonGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(240, 130, 40)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(160, 60, 10))
    })
    for i = cooldownDuration, 1, -1 do
        textLabel.Text = tostring(i)
        task.wait(1)
    end
    
    -- Reset back to default blue state
    textLabel.Text = "R"
    button.BackgroundColor3 = Color3.fromRGB(35, 120, 235)
    buttonGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(80, 160, 255)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(20, 90, 200))
    })
    isOnCooldown = false
end

-- Lock Toggle
lockButton.MouseButton1Click:Connect(function()
    isLocked = not isLocked
    if isLocked then
        lockButton.Text = "🔒 Lock"
        lockButton.TextColor3 = Color3.fromRGB(235, 90, 90)
        lockStroke.Color = Color3.fromRGB(120, 40, 40)
    else
        lockButton.Text = "🔓 Unlock"
        lockButton.TextColor3 = Color3.fromRGB(160, 160, 175)
        lockStroke.Color = Color3.fromRGB(50, 50, 60)
    end
end)

-- Dragging Logic
frame.InputBegan:Connect(function(input)
    if isLocked then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = frame.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

frame.InputChanged:Connect(function(input)
    if isLocked then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not isLocked and dragging and input == dragInput then
        local delta = input.Position - dragStart
        frame.Position = UDim2.new(
            startPos.X.Scale, 
            startPos.X.Offset + delta.X, 
            startPos.Y.Scale, 
            startPos.Y.Offset + delta.Y
        )
    end
end)

-- Click trigger
button.MouseButton1Click:Connect(runAbility)

-- Keyboard keybind trigger (Press R)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.R then
        runAbility()
    end
end)
