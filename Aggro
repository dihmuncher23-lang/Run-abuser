local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CoreGui = game:GetService("CoreGui")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer

-- Create the GUI elements
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "AggroButtonGui"
screenGui.Parent = CoreGui

local button = Instance.new("TextButton")
button.Name = "AggroButton"
button.Size = UDim2.new(0, 75, 0, 75)
button.Position = UDim2.new(0.5, -37.5, 0.75, -37.5)
button.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
button.TextColor3 = Color3.fromRGB(0, 0, 0)
button.TextSize = 14
button.Font = Enum.Font.SourceSansBold
button.Text = "AGGRO"
button.Parent = screenGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(1, 0)
corner.Parent = button

local stroke = Instance.new("UIStroke")
stroke.Color = Color3.fromRGB(255, 50, 50)
stroke.Thickness = 3
stroke.Parent = button

local lockButton = Instance.new("TextButton")
lockButton.Name = "LockButton"
lockButton.Size = UDim2.new(0, 24, 0, 24)
lockButton.Position = UDim2.new(1, -20, 0, -2)
lockButton.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
lockButton.TextColor3 = Color3.fromRGB(255, 255, 255)
lockButton.TextSize = 11
lockButton.Font = Enum.Font.SourceSansBold
lockButton.Text = "🔓"
lockButton.Parent = button

local lockCorner = Instance.new("UICorner")
lockCorner.CornerRadius = UDim.new(1, 0)
lockCorner.Parent = lockButton

local function getAggroTool()
    local currentCharacter = player.Character
    local backpack = player:FindFirstChildOfClass("Backpack")
    
    if currentCharacter and currentCharacter:FindFirstChild("Aggro") then
        return currentCharacter:FindFirstChild("Aggro")
    end
    
    if backpack and backpack:FindFirstChild("Aggro") then
        return backpack:FindFirstChild("Aggro")
    end
    
    return nil
end

local locked = false
local dragging = false
local dragInput, dragStart, startPos

lockButton.MouseButton1Click:Connect(function()
    locked = not locked
    if locked then
        lockButton.Text = "🔒"
        lockButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    else
        lockButton.Text = "🔓"
        lockButton.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    end
end)

button.InputBegan:Connect(function(input)
    if locked then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = button.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

button.InputChanged:Connect(function(input)
    if locked then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not locked and dragging and input == dragInput then
        local delta = input.Position - dragStart
        button.Position = UDim2.new(
            startPos.X.Scale, 
            startPos.X.Offset + delta.X, 
            startPos.Y.Scale, 
            startPos.Y.Offset + delta.Y
        )
    end
end)

local isCooldown = false
local cooldownTime = 6

button.MouseButton1Click:Connect(function()
    if isCooldown or dragging then return end
    
    local tool = getAggroTool()
    if not tool then
        button.Text = "NO"
        task.wait(1.5)
        button.Text = "AGGRO"
        return
    end

    -- Fire server first
    local success, err = pcall(function()
        ReplicatedStorage.GeneralAbility:FireServer()
    end)

    if not success then
        return
    end

    isCooldown = true

    -- Fetch character, humanoid, and animator FRESH on click
    local char = player.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")

    if not humanoid or not animator then
        isCooldown = false
        button.Text = "AGGRO"
        return
    end

    -- Capture speed right before changing it. If a debuff is active, we track the difference or handle it safely.
    local preAbilitySpeed = humanoid.WalkSpeed
    humanoid.WalkSpeed = 3

    -- Load and play animation dynamically
    local animObject = Instance.new("Animation")
    animObject.AnimationId = "rbxassetid://94305630911620"
    local animTrack = animator:LoadAnimation(animObject)
    animTrack:Play()

    -- Restore walkspeed safely when done or character dies, respecting any external speed changes during the ability
    task.spawn(function()
        local stopped = false
        local conn
        conn = animTrack.Stopped:Connect(function()
            stopped = true
        end)

        while not stopped and char and humanoid and humanoid.Health > 0 do
            task.wait(0.1)
        end

        if conn then conn:Disconnect() end

        if humanoid and humanoid.Parent then
            -- If your speed changed *while* the ability was active (e.g., you got hit by another debuff), 
            -- we keep the lowest/current applied modification rather than blindly forcing the old default back.
            if humanoid.WalkSpeed == 3 then
                humanoid.WalkSpeed = preAbilitySpeed
            end
        end
    end)

    -- Cooldown visual timer loop
    for i = cooldownTime, 1, -1 do
        button.Text = tostring(i)
        task.wait(1)
    end

    button.Text = "AGGRO"
    isCooldown = false
end)
