-- Dynamic RGB / Purple & Gold Color Loop Animation
local connection
connection = RunService.RenderStepped:Connect(function()
	if not screenGui.Parent then
		connection:Disconnect()
		return
	end
	
	local tickTime = tick() * 1.5
	local mixColor = Color3.fromRGB(
		math.floor((math.sin(tickTime) * 0.5 + 0.5) * 120 + 135),
		math.floor((math.cos(tickTime) * 0.5 + 0.5) * 80),
		180
	)
	
	bgCircle.BackgroundColor3 = mixColor
end)

-- Remote Event Activation
oraButton.MouseButton1Click:Connect(function()
	local success, err = pcall(function()
		ReplicatedStorage.GeneralAbility:FireServer()
	end)
	
	-- Button click visual feedback animation
	TweenService:Create(oraButton, TweenInfo.new(0.08), {Size = UDim2.new(0, 56, 0, 56)}):Play()
	task.wait(0.08)
	TweenService:Create(oraButton, TweenInfo.new(0.08), {Size = UDim2.new(0, 64, 0, 64)}):Play()
end)

-- Draggable & Lockable Logic
local isDragging = false
local isLocked = false
local dragInput, mousePos, framePos

lockButton.MouseButton1Click:Connect(function()
	isLocked = not isLocked
	if isLocked then
		lockButton.Text = "🔒"
		lockButton.BackgroundColor3 = Color3.fromRGB(80, 20, 20)
	else
		lockButton.Text = "🔓"
		lockButton.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	end
end)

mainFrame.InputBegan:Connect(function(input)
	if isLocked then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		isDragging = true
		mousePos = input.Position
		framePos = mainFrame.Position
		
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				isDragging = false
			end
		end)
	end
end)

mainFrame.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input == dragInput and isDragging and not isLocked then
		local delta = input.Position - mousePos
		mainFrame.Position = UDim2.new(
			framePos.X.Scale, 
			framePos.X.Offset + delta.X, 
			framePos.Y.Scale, 
			framePos.Y.Offset + delta.Y
		)
	end
end)
