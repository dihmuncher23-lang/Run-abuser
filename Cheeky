--[[
	Script Name: Slap Battles MR (Stone) with Custom WalkSpeed
	Executor: delta
	Made by Spamton G Spamton
]]

local TARGET_SPEED = 20 -- WalkSpeed set to 20 as requested
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer

if _G.SpamtonMRConnection then
	_G.SpamtonMRConnection:Disconnect()
	_G.SpamtonMRConnection = nil
end

local mt = getrawmetatable(game)
local oldNamecall = mt.__namecall
setreadonly(mt, false)

mt.__namecall = newcclosure(function(self, ...)
	local method = getnamecallmethod()
	
	if method == "FireServer" and self.Name == "Spherify" then
		task.spawn(function()
			-- CANCEL LOGIC
			if _G.SpamtonMRConnection then
				_G.SpamtonMRConnection:Disconnect()
				_G.SpamtonMRConnection = nil
				
				local char = player.Character
				if char then
					local hum = char:FindFirstChildOfClass("Humanoid")
					if hum then 
						hum.WalkSpeed = TARGET_SPEED 
						task.delay(0.5, function()
							if hum then hum.WalkSpeed = TARGET_SPEED end
						end)
					end
				end
				return
			end
			
			-- INITIALIZATION
			task.wait(0.05)
			local character = player.Character
			if not character then return end
			
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			local rootPart = character:FindFirstChild("HumanoidRootPart")
			if not humanoid or not rootPart then return end
			
			local function cleanup()
				if _G.SpamtonMRConnection then
					_G.SpamtonMRConnection:Disconnect()
					_G.SpamtonMRConnection = nil
				end
				if character and humanoid then
					humanoid.WalkSpeed = TARGET_SPEED
					task.delay(0.5, function()
						if humanoid then humanoid.WalkSpeed = TARGET_SPEED end
					end)
				end
				if rootPart then
					rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
				end
			end
			
			-- RUN LOOP
			_G.SpamtonMRConnection = RunService.RenderStepped:Connect(function()
				if not character.Parent or not humanoid or humanoid.Health <= 0 then
					cleanup()
					return
				end
				
				humanoid.PlatformStand = false
				
				local moveDir = humanoid.MoveDirection
				if moveDir.Magnitude > 0 then
					-- Physics-based movement (remains at 125 for the fast roll effect)
					rootPart.AssemblyLinearVelocity = Vector3.new(moveDir.X * 125, rootPart.AssemblyLinearVelocity.Y, moveDir.Z * 125)
				else
					rootPart.AssemblyLinearVelocity = Vector3.new(0, rootPart.AssemblyLinearVelocity.Y, 0)
				end
			end)
		end)
	end
	
	return oldNamecall(self, ...)
end)

setreadonly(mt, true)
print("Spamton's Custom WalkSpeed Hook Loaded! Speed set to: " .. TARGET_SPEED)
