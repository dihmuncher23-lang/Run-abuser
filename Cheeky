--[[
	Script Name: Slap Battles MR (Stone) with Custom WalkSpeed
	Executor: delta
	Made by Spamton G Spamton
]]

local TARGET_SPEED = 20 -- WalkSpeed set to 20 as requested
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer

if _G.SpamtonMRConnection then
	_G.SpamtonMRConnection:Disconnect()
	_G.SpamtonMRConnection = nil
end

if _G.SpamtonRespawnConnection then
	_G.SpamtonRespawnConnection:Disconnect()
	_G.SpamtonRespawnConnection = nil
end

local function resetSpeed(hum)
	if hum then
		hum.WalkSpeed = TARGET_SPEED
		task.delay(0.5, function()
			if hum then hum.WalkSpeed = TARGET_SPEED end
		end)
	end
end

-- Global cleanup helper so respawns also kill active loops and reset speeds
local function forceCleanup()
	if _G.SpamtonMRConnection then
		_G.SpamtonMRConnection:Disconnect()
		_G.SpamtonMRConnection = nil
	end
	local char = player.Character
	if char then
		local hum = char:FindFirstChildOfClass("Humanoid")
		resetSpeed(hum)
		local rootPart = char:FindFirstChild("HumanoidRootPart")
		if rootPart then
			rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		end
	end
end

-- Listen for character respawns to handle death + remote re-fires cleanly
_G.SpamtonRespawnConnection = player.CharacterAdded:Connect(function(newChar)
	forceCleanup()
	newChar:WaitForChild("Humanoid").Died:Connect(function()
		forceCleanup()
	end)
end)

if player.Character then
	player.Character:WaitForChild("Humanoid").Died:Connect(function()
		forceCleanup()
	end)
end

local mt = getrawmetatable(game)
local oldNamecall = mt.__namecall
setreadonly(mt, false)

mt.__namecall = newcclosure(function(self, ...)
	local method = getnamecallmethod()
	
	if method == "FireServer" and self.Name == "Spherify" then
		task.spawn(function()
			-- CANCEL LOGIC (fires when remote is triggered a second time)
			if _G.SpamtonMRConnection then
				forceCleanup()
				return
			end
			
			-- INITIALIZATION
			task.wait(0.05)
			local character = player.Character
			if not character then return end
			
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			local rootPart = character:FindFirstChild("HumanoidRootPart")
			if not humanoid or not rootPart then return end
			
			-- RUN LOOP
			_G.SpamtonMRConnection = RunService.RenderStepped:Connect(function()
				if not character.Parent or not humanoid or humanoid.Health <= 0 then
					forceCleanup()
					return
				end
				
				humanoid.PlatformStand = false
				
				local moveDir = humanoid.MoveDirection
				if moveDir.Magnitude > 0 then
					-- Physics-based movement (remains at 125 for the fast roll effect)
					rootPart.AssemblyLinearVelocity = Vector3.new(moveDir.X * 125, rootPart.AssemblyLinearVelocity.Y, moveDir.Z * 125)
				else
					rootPart.AssemblyLinearVelocity = Vector3.new(0, rootPart.AssemblyLinearVelocity.Y, 0)
				end
			end)
		end)
	end
	
	return oldNamecall(self, ...)
end)

setreadonly(mt, true)
print("Spamton's Custom WalkSpeed Hook Loaded! Speed set to: " .. TARGET_SPEED)
